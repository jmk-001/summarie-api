generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())

  email         String    @unique
  passwordHash  String

  documents     Document[]
  promptPresets PromptPreset[]
  summaryJobs   SummaryJob[]
  results       SummaryResult[]
}

model Document {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())

  title         String
  content       String

  sourceType    String
  sourceUrl     String?

  summaryJobs   SummaryJob[]
}

model PromptPreset {
  id            String     @id @default(cuid())
  ownerId       String
  owner         User       @relation(fields: [ownerId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  name          String
  description   String?

  schemaVersion Int        @default(1)
  params        Json

  visibility    PromptVisibility @default(private)

  jobs          SummaryJob[]

  @@index([createdAt])
  @@index([name])
}

model SummaryJob {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])

  documentId     String
  document       Document  @relation(fields: [documentId], references: [id])
  model          String    @default("gpt-mock")

  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  status         SummaryJobStatus @default(queued)
  error          String?
  attempts       Int       @default(0)
  idempotencyKey String?   @unique

  presetId       String?
  preset         PromptPreset? @relation(fields: [presetId], references: [id])

  schemaVersion  Int
  paramsSnapshot Json

  result         SummaryResult?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([presetId])
  @@unique([userId, idempotencyKey])
}

model SummaryResult {
  id              String    @id @default(cuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])

  jobId           String    @unique
  job             SummaryJob @relation(fields: [jobId], references: [id])

  createdAt       DateTime  @default(now())
  content         String
  tokensUsed      Int
  model           String    @default("gpt-mock")
}

enum PromptVisibility {
  private
  organization
  public
}

enum SummaryJobStatus {
  queued
  running
  done
  error
}
