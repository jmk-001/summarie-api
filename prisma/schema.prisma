generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  
  email         String    @unique
  passwordHash  String

  documents     Document[]
}

model Document {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  
  title         String
  content       String

  sourceType    String
  sourceUrl     String?
}

enum SummaryJobStatus {
  queued
  running
  done
  error
}

model SummaryJob {
  id            String    @id @default(cuid())
  userId        String?
  documentId    String
  createdAt     DateTime  @default(now())

  startedAt     DateTime?
  finishedAt    DateTime?
  error         String?

  status        SummaryJobStatus
  params        Json
}

enum Models {
  gpt_3_5_turbo
  gpt_3_5_turbo_16k
  gpt_4o_mini
  gpt_4o_mini_2024_07_18
}

model SummaryResult {
  id            String    @id @default(cuid())
  jobId         String?
  createdAt     DateTime  @default(now())

  content       String
  tokensUsed    Int
  model         Models
}