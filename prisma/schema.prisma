generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())

  email         String    @unique
  passwordHash  String

  documents     Document[]
  promptPresets PromptPreset[] @relation("UserToPreset")
  summaryJobs   SummaryJob[]   @relation("UserToJob")
}

model Document {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())

  title         String
  content       String

  sourceType    String
  sourceUrl     String?

  summaryJobs   SummaryJob[] @relation("DocumentToJob")
}

model PromptPreset {
  id            String     @id @default(cuid())
  ownerId       String
  owner         User       @relation("UserToPreset", fields: [ownerId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  name          String
  description   String?

  schemaVersion Int        @default(1)
  params        Json

  visibility    PromptVisibility @default(private)

  jobs          SummaryJob[] @relation("PresetToJob")

  @@index([createdAt])
  @@index([name])
}

model SummaryJob {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation("UserToJob", fields: [userId], references: [id])

  documentId     String
  document       Document  @relation("DocumentToJob", fields: [documentId], references: [id])

  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  status         SummaryJobStatus @default(queued)
  error          String?
  attempts       Int       @default(0)
  idempotencyKey String?   @unique

  presetId       String?
  preset         PromptPreset? @relation("PresetToJob", fields: [presetId], references: [id])

  schemaVersion  Int
  paramsSnapshot Json

  result         SummaryResult? @relation("JobToResult")

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([presetId])
}

model SummaryResult {
  id            String    @id @default(cuid())

  jobId         String    @unique
  job           SummaryJob @relation("JobToResult", fields: [jobId], references: [id])

  createdAt     DateTime  @default(now())
  content       String
  tokensUsed    Int
  model         Models
}

enum PromptVisibility {
  private
  organization
  public
}

enum SummaryJobStatus {
  queued
  running
  done
  error
}

enum Models {
  gpt_mock
  gpt_3_5_turbo
  gpt_3_5_turbo_16k
  gpt_4o_mini
  gpt_4o_mini_2024_07_18
}
